# ==============================================================================
# uv-mirror Docker 設定例 (.env)
# ==============================================================================

# Web サーバーの公開ポート（デフォルト: 80）
# 既存の Web サーバーと衝突する場合は 8080 等に変更してください
UV_MIRROR_PORT=80

# ホスト側の mirror_data 格納ディレクトリ
# デフォルトは ../mirror_data です。
# ホストの固定ディレクトリ（例: /var/www/uv-mirror）に配置している場合はここを変更してください
UV_DATA_DIR=../mirror_data
